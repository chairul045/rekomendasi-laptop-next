# ==============================================================================
# LAPMATCH - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env.local dan isi dengan nilai kredensial Anda.
# PENTING: JANGAN PERNAH menyimpan kredensial produksi asli di file ini atau commit ke Git!
# ==============================================================================

# Database PostgreSQL (Supabase Connection Pooling - pgBouncer port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Database PostgreSQL Direct URL (untuk Prisma Migrate & Prisma Seeding - port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Public Configuration (Aman untuk Client/Browser)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (HANYA DIGUNAKAN DI SERVER - JANGAN PERNAH DIEKSPOSE KE CLIENT!)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Google Generative AI (Gemini Flash API Key)
GEMINI_API_KEY="AIzaSy..."

# Administrator Whitelist Emails (Daftar email admin resmi, pisahkan koma jika lebih dari satu)
ADMIN_WHITELIST_EMAILS="admin@example.com"

# Konfigurasi Aplikasi Publik
NEXT_PUBLIC_APP_NAME="Lapmatch"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
